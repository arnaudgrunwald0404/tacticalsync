echo "🔍 Running pre-commit checks..."

# Check if we're in the right directory
if [ ! -d "supabase/migrations" ]; then
  echo "❌ Not in project root directory"
  exit 1
fi

# Validate migrations
echo "📋 Validating migrations..."
if ! node scripts/validate-migrations.js; then
  echo "❌ Migration validation failed — commit aborted."
  exit 1
fi

# Check database health (only if Supabase is running)
echo "🏥 Checking database health..."
if command -v supabase >/dev/null 2>&1; then
  if supabase status >/dev/null 2>&1; then
    if ! node scripts/check-db-health.js; then
      echo "❌ Database health check failed — commit aborted."
      exit 1
    fi
  else
    echo "⚠️  Supabase not running - skipping database health check"
  fi
else
  echo "⚠️  Supabase CLI not found - skipping database health check"
fi

echo "✅ Pre-commit checks passed!"